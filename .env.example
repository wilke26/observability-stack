# Alle Images sind absichtlich auf reproduzierbare Versionen festgelegt.
PROMETHEUS_VERSION=v3.12.0
GRAFANA_VERSION=13.1.0
LOKI_VERSION=3.6.11
ALLOY_VERSION=v1.19.2
OTEL_COLLECTOR_VERSION=0.157.0
BUSYBOX_VERSION=1.37.0

# Nur lokal erreichbar. Für LAN-Zugriff bewusst auf 0.0.0.0 ändern.
BIND_ADDRESS=127.0.0.1
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LOKI_PORT=3100
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_PROMETHEUS_PORT=8889

GRAFANA_ADMIN_USER=admin
# Vor dem Start unbedingt durch ein langes, eigenes Passwort ersetzen.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_NOW

PROMETHEUS_RETENTION=15d
LOG_INTERVAL_SECONDS=15
